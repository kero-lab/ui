{
  "name": "@remlab/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "storybook": "node node_modules/.bin/storybook dev -p 6006",
    "build-storybook": "node node_modules/.bin/storybook build",
    "test": "vitest",
    "test:unit": "vitest --project unit",
